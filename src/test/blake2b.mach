test blake2b__invalid_inputs_are_retryable_and_final_consumes_state {
    var context: b.State          = b.empty();
    var output:  [64]u8;
    val buffer:  contracts.Buffer = contracts.Buffer{data: ?output[0], capacity: 64};
    if (b.init(nil, 64) != contracts.INVALID_INPUT)                                                                                                                            { ret 1; }
    if (b.init(?context, 0) != contracts.INVALID_INPUT || context.active != 0)                                                                                                 { ret 2; }
    if (b.init(?context, 65) != contracts.INVALID_INPUT || context.active != 0)                                                                                                { ret 3; }
    if (b.update(?context, contracts.Bytes{data: nil, len: 0}) != contracts.INVALID_STATE)                                                                                     { ret 4; }
    if (b.init(?context, 64) != contracts.OK)                                                                                                                                  { ret 5; }
    if (b.init(?context, 64) != contracts.INVALID_STATE)                                                                                                                       { ret 6; }
    if (b.update(?context, contracts.Bytes{data: nil, len: 1}) != contracts.INVALID_INPUT)                                                                                     { ret 7; }
    if (b.update(?context, contracts.Bytes{data: nil, len: 0}) != contracts.OK)                                                                                                { ret 8; }
    if (b.final(?context, contracts.Buffer{data: ?output[0], capacity: 63}).error != contracts.OUTPUT_TOO_SMALL)                                                               { ret 9; }
    if (b.final(?context, contracts.Buffer{data: nil, capacity: 64}).error != contracts.INVALID_INPUT)                                                                         { ret 10; }
    if (b.update(?context, contracts.Bytes{data: "abc"::*u8, len: 3}) != contracts.OK)                                                                                         { ret 11; }
    if (b.final(?context, buffer).error != contracts.OK)                                                                                                                       { ret 12; }
    if (matches(?output[0], "ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923"::*u8, 64) == 0) { ret 13; }
    if (b.final(?context, buffer).error != contracts.INVALID_STATE)                                                                                                            { ret 14; }
    if (b.destroy(?context) != contracts.OK || b.destroy(?context) != contracts.OK)                                                                                            { ret 15; }
    if (b.init(?context, 32) != contracts.OK)                                                                                                                                  { ret 16; }
    context.total = 0xffffffffffffff80u64;
    context.used  = 127;
    if (b.update(?context, contracts.Bytes{data: "x"::*u8, len: 1}) != contracts.INVALID_INPUT) { ret 17; }
    if (context.total != 0xffffffffffffff80u64 || context.used != 127)                          { ret 18; }
    context.used = 129;
    if (b.final(?context, buffer).error != contracts.INVALID_STATE) { ret 19; }
    if (b.destroy(?context) != contracts.OK)                        { ret 20; }
    var i: usize = 0;
    for (i < 8) {
        if (context.h[i] != 0) { ret 21; }
        i = i + 1;
    }
    i = 0;
    for (i < 128) {
        if (context.block[i] != 0) { ret 22; }
        i = i + 1;
    }
    ret 0;
}

test blake2b__hashlib_megabyte_byte_fragments {
    var context: b.State = b.empty();
    if (b.init(?context, 64) != contracts.OK) { ret 1; }
    var input:  [256]u8;
    var output: [64]u8;
    var i:      usize = 0;
    for (i < 256) {
        input[i] = i::u8;
        i        = i + 1;
    }
    var block: usize = 0;
    for (block < 4096) {
        i = 0;
        for (i < 256) {
            if (b.update(?context, contracts.Bytes{data: ?input[i], len: 1}) != contracts.OK) { ret 2; }
            i = i + 1;
        }
        block = block + 1;
    }
    if (b.final(?context, contracts.Buffer{data: ?output[0], capacity: 64}).error != contracts.OK)                                                                             { ret 3; }
    if (matches(?output[0], "988b9f48e713f594ab9d5bbac2de5f1f04714169d0ff806844089dfed9d7dcad92d90e5c7d9d0676042e059ab231b6839113f2d2b8abf631ee0a49c593d4491d"::*u8, 64) == 0) { ret 4; }
    ret 0;
}

# generated with minisign 0.12, modern ED format, over bytes 0..255 repeated
# 4096 times. only public key/signature bytes are retained; no signing secret.
test blake2b__minisign_megabyte_signature {
    var key: [32]u8 = [32]u8{0x79, 0x30, 0x9c, 0xd9, 0x34, 0xb3, 0x9a, 0xd4, 0x71, 0x33, 0xff, 0x18, 0xf7, 0xd8, 0x33, 0x63, 0x7f, 0x48, 0x79, 0x1b, 0x29, 0xf7, 0xe1, 0xc7, 0xbd, 0x00, 0xa6, 0xce, 0xf7, 0xd0, 0x06, 0x62};
    var sig: [64]u8 = [64]u8{0x65, 0xb8, 0xc5, 0xba, 0x34, 0xd4, 0x0b, 0x6e, 0x63, 0x3c, 0x50, 0xa1, 0x20, 0x5a, 0xf7, 0xd9, 0x1e, 0xcf, 0x70, 0x0d, 0x6e, 0x61, 0x5c, 0x29, 0x53, 0x21, 0x1d, 0x92, 0xff, 0xd4, 0x4d, 0x72, 0xb9, 0x74, 0xda, 0xb9, 0xa3, 0x70, 0x3f, 0x99, 0xba, 0xdf, 0x0f, 0x22, 0x51, 0x20, 0x57, 0xdb, 0x88, 0x2a, 0x2f, 0x2f, 0xf8, 0x0c, 0x2d, 0xf3, 0xf8, 0xa7, 0x68, 0x32, 0x91, 0x22, 0x0d, 0x06};

    var context: b.State = b.empty();
    var input:   [256]u8;
    var digest:  [64]u8;
    var i:       usize   = 0;
    for (i < 256) {
        input[i] = i::u8;
        i        = i + 1;
    }
    if (b.init(?context, 64) != contracts.OK) { ret 1; }
    i = 0;
    for (i < 4096) {
        if (b.update(?context, contracts.Bytes{data: ?input[0], len: 256}) != contracts.OK) { ret 2; }
        i = i + 1;
    }
    if (b.final(?context, contracts.Buffer{data: ?digest[0], capacity: 64}).error != contracts.OK) { ret 3; }
    val public_key: contracts.Bytes = contracts.Bytes{data: ?key[0], len: 32};
    val message:    contracts.Bytes = contracts.Bytes{data: ?digest[0], len: 64};
    val signed:     contracts.Bytes = contracts.Bytes{data: ?sig[0], len: 64};
    if (signature.verify_ed25519(public_key, message, signed) != contracts.OK) { ret 4; }
    digest[0] = digest[0] ^ 1;
    if (signature.verify_ed25519(public_key, message, signed) == contracts.OK) { ret 5; }
    ret 0;
}
