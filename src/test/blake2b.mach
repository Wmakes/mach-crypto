# BLAKE2b vectors and contract checks; differential vectors use Python hashlib
# RFC 7693 section A supplies the abc BLAKE2b-512 vector.

use crypto.contracts;
use b: crypto.hash.blake2b;
use crypto.signature;
use std.types.size.usize;

#[testing]
fun matches(data: *u8, expected: *u8, n: usize) u8 {
    var i: usize = 0;
    for (i < n) {
        val hi: u8 = expected[i * 2];
        val lo: u8 = expected[i * 2 + 1];
        var h:  u8 = hi - '0';
        var l:  u8 = lo - '0';
        if (hi >= 'a')                 { h = hi - 'a' + 10; }
        if (lo >= 'a')                 { l = lo - 'a' + 10; }
        if (data[i] != ((h << 4) | l)) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

#[testing]
fun vector(input: *u8, n: usize, size: usize, expected: *u8) u8 {
    var output: [64]u8;
    val result: contracts.Operation = b.hash(contracts.Bytes{data: input, len: n},
        contracts.Buffer{data: ?output[0], capacity: 64}, size);
    if (result.error != contracts.OK || result.written != size ||
        matches(?output[0], expected, size) == 0) { ret 1; }
    var split: usize = 0;
    for (split <= n) {
        var context: b.State = b.empty();
        if (b.init(?context, size) != contracts.OK)                                                       { ret 2; }
        if (b.update(?context, contracts.Bytes{data: input, len: split}) != contracts.OK)                 { ret 3; }
        if (b.snapshot(?context, contracts.Buffer{data: ?output[0], capacity: 64}).error != contracts.OK) { ret 4; }
        if (b.update(?context, contracts.Bytes{data: ?input[split], len: n - split}) != contracts.OK)     { ret 5; }
        val done: contracts.Operation = b.final(?context, contracts.Buffer{data: ?output[0], capacity: 64});
        if (done.error != contracts.OK || done.written != size ||
            matches(?output[0], expected, size) == 0) { ret 6; }
        if (context.active != 0 || context.total != 0 || context.used != 0) { ret 7; }
        split = split + 1;
    }
    ret 0;
}

test blake2b__rfc7693_abc {
    ret vector("abc"::*u8, 3, 64,
        "ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923"::*u8)::i32;
}

test blake2b__hashlib_block_boundaries_and_every_split {
    var input: [257]u8;
    var i:     usize = 0;
    for (i < 257) {
        input[i] = i::u8;
        i        = i + 1;
    }
    if (vector(?input[0], 0, 64, "786a02f742015903c6c6fd852552d272912f4740e15847618a86e217f71f5419d25e1031afee585313896444934eb04b903a685b1448b755d56f701afe9be2ce"::*u8) != 0)   { ret 1; }
    if (vector(?input[0], 1, 64, "2fa3f686df876995167e7c2e5d74c4c7b6e48f8068fe0e44208344d480f7904c36963e44115fe3eb2a3ac8694c28bcb4f5a0f3276f2e79487d8219057a506e4b"::*u8) != 0)   { ret 2; }
    if (vector(?input[0], 127, 64, "b6292669ccd38d5f01caae96ba272c76a879a45743afa0725d83b9ebb26665b731f1848c52f11972b6644f554c064fa90780dbbbf3a89d4fc31f67df3e5857ef"::*u8) != 0) { ret 128; }
    if (vector(?input[0], 128, 64, "2319e3789c47e2daa5fe807f61bec2a1a6537fa03f19ff32e87eecbfd64b7e0e8ccff439ac333b040f19b0c4ddd11a61e24ac1fe0f10a039806c5dcc0da3d115"::*u8) != 0) { ret 129; }
    if (vector(?input[0], 129, 64, "f59711d44a031d5f97a9413c065d1e614c417ede998590325f49bad2fd444d3e4418be19aec4e11449ac1a57207898bc57d76a1bcf3566292c20c683a5c4648f"::*u8) != 0) { ret 130; }
    if (vector(?input[0], 255, 64, "5b21c5fd8868367612474fa2e70e9cfa2201ffeee8fafab5797ad58fefa17c9b5b107da4a3db6320baaf2c8617d5a51df914ae88da3867c2d41f0cc14fa67928"::*u8) != 0) { ret 6; }
    if (vector(?input[0], 256, 64, "1ecc896f34d3f9cac484c73f75f6a5fb58ee6784be41b35f46067b9c65c63a6794d3d744112c653f73dd7deb6666204c5a9bfa5b46081fc10fdbe7884fa5cbf8"::*u8) != 0) { ret 7; }
    if (vector(?input[0], 257, 64, "d8bfe068de0b4f9fa876a3f8024eb9f7b0029fd5dcf251199e065cee89e1a282c8dbf0442f2ade7294ac1c6be19b388dc990c34d8cb79f5f10c54fa813834fda"::*u8) != 0) { ret 8; }
    ret 0;
}

